{
  "name": "the-daily-pantry",
  "private": true,
  "version": "1.0.0",
  "description": "A modern grocery landing page with warm food-inspired design",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd ..\\server && node server.js",
    "seed": "cd ..\\server && node scripts/seed.js",
    "dev:full": "concurrently -n SERVER,CLIENT -c red,cyan \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "gsap": "^3.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-slick": "^0.30.3",
    "remixicon": "^4.6.0",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "vite": "^7.0.0"
  }
}
